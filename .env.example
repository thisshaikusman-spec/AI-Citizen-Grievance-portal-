# Backend API Base URL (from your running FastAPI backend server)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Supabase Project URL (from Supabase Dashboard > Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://gwmfyulvgznvawdsofdt.supabase.co

# Supabase Publishable / Anon API Key (from Supabase Dashboard > Project Settings > API > Project API Keys)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_s8Y9GIfcedicUonBfX0q_Q_PWMFOhAw

# Verification method: none | email | phone (default: email if VITE_REQUIRE_EMAIL_OTP=true, else none)
# If both VITE_VERIFICATION_METHOD and VITE_REQUIRE_EMAIL_OTP are set, VITE_VERIFICATION_METHOD wins.
# Must match VERIFICATION_METHOD in the backend.
VITE_VERIFICATION_METHOD=email

# Legacy flag (alias: true -> email, false -> none)
# must match REQUIRE_EMAIL_VERIFICATION in the backend
VITE_REQUIRE_EMAIL_OTP=true
